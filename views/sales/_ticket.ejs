<% const t = view.ticket; %>
<div class="card">
  <div class="page-head" style="margin-bottom:.5rem">
    <h2 style="margin:0">Ticket #<%= t.number %></h2>
    <div class="spacer"></div>
    <span class="badge <%= t.status %>"><%= t.status %></span>
  </div>
  <p style="margin:.2rem 0 .6rem;color:var(--muted);font-size:.85rem">
    <%= view.client ? view.client.first_name + ' ' + view.client.last_name1 : 'Público General' %>
    <% if (t.appointment_id) { %> · Cita #<%= t.appointment_id %><% } %>
  </p>

  <table class="data">
    <thead><tr><th>Concepto</th><th class="num">Cant.</th><th class="num">Precio</th><th class="num">Importe</th><th></th></tr></thead>
    <tbody>
    <% if (!view.lines.length) { %><tr><td colspan="5" style="color:var(--muted)">Agrega servicios o productos</td></tr><% } %>
    <% view.lines.forEach(l => { %>
      <tr>
        <td><%= l.name %><% if (l.staff_name) { %><br><small style="color:var(--muted)"><%= l.staff_name %></small><% } %></td>
        <td class="num"><%= l.qty %></td>
        <td class="num">$<%= Number(l.price).toFixed(2) %></td>
        <td class="num">$<%= (l.qty * l.price).toFixed(2) %></td>
        <td>
          <form class="inline" method="post" action="/ventas/linea/<%= l.id %>/quitar" hx-post="/ventas/linea/<%= l.id %>/quitar" hx-target="#ticket-panel" hx-swap="innerHTML">
            <button class="btn small danger" type="submit">✕</button>
          </form>
        </td>
      </tr>
    <% }) %>
    </tbody>
    <tfoot>
      <tr><td colspan="3" class="num">Subtotal</td><td class="num">$<%= view.totals.subtotal.toFixed(2) %></td><td></td></tr>
      <tr><td colspan="3" class="num">IVA</td><td class="num">$<%= view.totals.tax_total.toFixed(2) %></td><td></td></tr>
      <tr style="font-weight:700"><td colspan="3" class="num">Total</td><td class="num">$<%= view.totals.total.toFixed(2) %></td><td></td></tr>
    </tfoot>
  </table>

  <h2>Cobro</h2>
  <form method="post" action="/ventas/cobrar">
    <input type="hidden" name="ticket" value="<%= t.id %>">
    <div class="pay-grid">
      <% const defaults = { cash: view.totals.total, transfer: 0, card: 0, credit: 0, gift: 0, other: 0 }; %>
      <% view.methods.forEach(([key, label]) => { %>
        <label><%= label %></label>
        <input type="number" step="0.01" min="0" name="m_<%= key %>" value="<%= Number(defaults[key]).toFixed(2) %>" <%= key === 'cash' ? '' : 'placeholder="0.00"' %>>
        <% if (key === 'transfer') { %>
          <label style="grid-column:1;font-weight:400;font-size:.78rem">Banco</label>
          <input type="text" name="bank_transfer" placeholder="BBVA / Banorte…" style="grid-column:2">
        <% } %>
      <% }) %>
    </div>
    <p style="color:var(--muted);font-size:.78rem">La suma debe ser igual a $<%= view.totals.total.toFixed(2) %>.</p>
    <button class="btn block" type="submit" style="font-size:1rem;padding:.6rem">Cobrar</button>
    <a class="btn secondary block" href="/ventas/<%= t.id %>/cancelar" onclick="return confirm('¿Cancelar este ticket?')">Cancelar ticket</a>
  </form>
</div>
