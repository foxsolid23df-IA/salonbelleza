<%- include('../partials/head') %>
<div class="page-head">
  <h1><%= service ? 'Editar servicio' : 'Nuevo servicio' %></h1>
  <div class="spacer"></div>
  <a class="btn secondary" href="/servicios">Volver</a>
</div>
<div class="card">
  <form method="post" action="/servicios/guardar">
    <% if (service) { %><input type="hidden" name="id" value="<%= service.id %>"><% } %>
    <div class="row cols-2">
      <div><label>Nombre *</label><input type="text" name="name" required value="<%= service ? service.name : '' %>"></div>
      <div><label>Familia</label>
        <select name="family_id">
          <option value="">Sin familia</option>
          <% families.forEach(f => { %><option value="<%= f.id %>" <%= service && service.family_id === f.id ? 'selected' : '' %>><%= f.name %></option><% }) %>
        </select>
      </div>
      <div><label>Precio</label><input type="number" step="0.01" name="price" value="<%= service ? service.price : '0' %>"></div>
      <div><label>Duración (min)</label><input type="number" step="5" min="5" name="duration_min" value="<%= service ? service.duration_min : 30 %>"></div>
      <div><label>Color de agenda</label><input type="text" name="color" placeholder="#8b5cf6" value="<%= service ? service.color : '' %>"></div>
      <div><label>Tasa de IVA (ej. 0.16)</label><input type="number" step="0.01" name="tax_rate" value="<%= service ? service.tax_rate : 0.16 %>"></div>
      <div><label>Costo</label><input type="number" step="0.01" name="cost" value="<%= service ? service.cost : 0 %>"></div>
      <div><label style="display:flex;gap:.4rem;align-items:center"><input type="checkbox" name="bookable" style="width:auto" <%= !service || service.bookable ? 'checked' : '' %>> Reservable en línea</label></div>
      <div><label style="display:flex;gap:.4rem;align-items:center"><input type="checkbox" name="active" style="width:auto" <%= !service || service.active ? 'checked' : '' %>> Activo</label></div>
    </div>
    <div style="height:.8rem"></div>
    <button class="btn" type="submit">Guardar</button>
  </form>
</div>
<%- include('../partials/foot') %>
